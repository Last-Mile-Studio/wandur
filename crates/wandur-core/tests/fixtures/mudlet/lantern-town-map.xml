<?xml version="1.0" encoding="UTF-8"?>
<!-- The official map of the bench's GMCP demo world (wandur-bench mud-server --page gmcp):
     the same room numbers, so it lines up with the rooms the world sends in Room.Info.
     Hand-written and fictional, for trying GMCP Client.Map by hand: put this file on any https
     address and start the bench with the client-map option: https://.../lantern-town-map.xml -->
<map>
 <areas>
  <area id="1" name="Lantern Town" />
  <area id="2" name="Greenway" />
 </areas>
 <rooms>
  <room id="100" area="1" title="Town Gate" environment="1">
